# Optional CoinGecko demo API key (higher rate limits). Leave unset to use
# the public free tier as-is.
COINGECKO_API_KEY=

# Seconds to cache CoinGecko/DeFiLlama responses in memory.
CACHE_TTL_SECONDS=60

# How many pages of 250 coins each to screen (ordered by market cap desc).
MARKET_PAGES=4

# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
